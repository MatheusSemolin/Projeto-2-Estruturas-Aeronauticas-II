% =========================================================================
% SCRIPT PRINCIPAL: MARGENS DE SEGURANCA A TENSAO SEMI-DIAGONAL (GRUPO EXCEL)
% =========================================================================
clear; clc;

%% 1. DADOS CONSTANTES DO PAINEL
tau_apl = 72;        % Tensao de cisalhamento aplicada [MPa]
R = 2000;            % Raio de curvatura do painel [mm]
d = 320;             % Distancia longitudinal entre cavernas [mm]
h = 185;             % Distancia transversal entre longerons [mm]
t = 0.80;            % Espessura da chapa do painel [mm]
E = 72394.98;        % Modulo de elasticidade do Al7075 [MPa]
nu = 0.33;           % Coeficiente de Poisson 
tau_cr = 6.3665;     % Tensao critica (assumida do f_s_cr) [MPa]
sigma_y = 500;       % Escoamento padrao Al7075-T6 [MPa]

%% 2. VETORES DE DADOS DOS REFORCADORES (Ordem: [Seccao J, Seccao Z, Seccao C])
nomes = ["Longeron J", "Longeron Z", "Caverna C"];
is_longeron = [1, 1, 0]; 

% --- CARGAS REAIS RETIRADAS DO ENUNCIADO ---
N_cargas  = [1560, 1560, 37600];    
Mt_cargas = [85000, 85000, 115000]; 
Mr_cargas = [2400, 2400, 37000];    

% --- DADOS GEOMETRICOS (ATUALIZADOS PELO EXCEL) ---
n_ref = [1, 1, 2];             
Area  = [233.344, 135.708, 687.073]; % Areas extraidas [mm^2]

% (Inercia ficticia para o calculo do raio de giracao 'rho')
I_eta = [1000, 1000, 1000];    
e_exc = [21.7756, 35.2561, 39.1217]; % Excentricidades extraidas [mm]
y_max = [0, 0, 0];             % Distancia da borda zerada (Flexao = 0)

t_bar = [1.0, 1.0, 3.0];       

% --- DADOS DE FLAMBAGEM ---
s_adm       = [235.4272, 153.3154, 0]; 
F_cc_cr     = [0, 0, 144.48];          
s_c_cr_0    = [11.2455, 11.2455, 0];   % f_c_cr extraido do Excel [MPa]
s_s_cr_0    = [6.3665, 6.3665, 0];     % f_s_cr extraido do Excel [MPa]

%% 3. CALCULO DO ANGULO GLOBAL (ALPHA) DO PAINEL
A_long_med = mean(Area(1:2));
I_long_med = mean(I_eta(1:2));
e_long_med = mean(e_exc(1:2));
rho_long = sqrt(I_long_med / A_long_med);
Ase = A_long_med / (1 + (e_long_med^2 / rho_long^2)); 

A_cav = Area(3);
I_cav = I_eta(3);
e_cav = e_exc(3);
rho_cav = sqrt(I_cav / A_cav);
Are = A_cav / (1 + (e_cav^2 / rho_cav^2)); 

alpha = pi/4; K = 0.5; erro = 1; tol = 1e-4; iter = 0; max_iter = 500;
c_linha = max(d/h, h/d); 

while erro > tol && iter < max_iter
    iter = iter + 1;
    a_ant = alpha; K_ant = K;
    he_h = 0.5 * (1 - K); de_d = 0.5 * (1 - K);
    
    eps_sk = ((2*K / sin(2*alpha)) + (1-K)*(1-nu)*sin(2*alpha)) * (tau_apl / E);
    eps_s  = (1 / (tan(alpha) * ((Ase / (h*t)) + he_h))) * (tau_apl / E);
    eps_r  = (tan(alpha) / ((Are / (d*t)) + de_d)) * (tau_apl / E);
    
    eps_ast = (1/8) * (d^2 / R^2) * (tan(alpha))^2; 
    
    tan2_alpha = (eps_sk + eps_s) / (eps_sk + eps_r + eps_ast);
    alpha = atan(sqrt(tan2_alpha));
    termo_K = (0.5 + 300*(t/R)*c_linha) * log10(tau_apl / tau_cr);
    K = tanh(termo_K);
    
    erro = max(abs(alpha - a_ant), abs(K - K_ant));
end

fprintf('======================================================\n');
fprintf(' DADOS GLOBAIS DO PAINEL (TSD)\n');
fprintf('======================================================\n');
fprintf('Iteracoes : %d \nFator K   : %.4f \nAngulo    : %.2f graus\n\n', iter, K, rad2deg(alpha));

%% 4. AVALIACAO DOS REFORCADORES INDIVIDUAIS
fprintf('======================================================\n');
fprintf(' RESULTADOS DAS MARGENS DE SEGURANCA\n');
fprintf('======================================================\n\n');

for i = 1:3
    nome = nomes(i); is_long = is_longeron(i);
    A = Area(i); I = I_eta(i); e = e_exc(i);
    N = N_cargas(i); Mt = Mt_cargas(i); Mr = Mr_cargas(i);
    n = n_ref(i); ymax = y_max(i); tb = t_bar(i);
    
    if is_long
        sigma_induzida = tau_apl * ((h*t)/A) * (1/tan(alpha)); 
    else
        sigma_induzida = tau_apl * ((d*t)/A) * tan(alpha);
    end
    
    M_total = Mt + Mr; 
    sigma_flexao = (M_total * ymax) / I; % DARA ZERO DEVIDO AO Y_MAX = 0
    
    fprintf('--- %s ---\n', nome);
    
    if is_long == 1 
        param_A = s_s_cr_0(i) / s_c_cr_0(i);
        param_B = tau_cr / s_c_cr_0(i);
        
        R_tau = -(param_A / (2*param_B)) + sqrt((param_A^2 / (4*param_B^2)) + 1);
        R_c = (param_A / param_B) * R_tau;
        sigma_c_cr = R_c * s_c_cr_0(i);
        
        Area_colaborante = (n * A) + (h * t);
        P_axial = N; 
        
        D = 0.445 * ((h*t)/(n * A)) * R_c * sqrt(sigma_c_cr); 
        termo_raiz = max(0, D^2 - (P_axial / Area_colaborante));
        sigma_c_bar = (P_axial / Area_colaborante) + 2*D*sqrt(termo_raiz);
        
        sigma_apl = sigma_c_bar + sigma_induzida + sigma_flexao; 
        MS = (s_adm(i) / sigma_apl) - 1; 
        
        fprintf('Tensao TSD Induzida : %8.2f MPa\n', sigma_induzida);
        fprintf('Tensao Comp. Equiv. : %8.2f MPa\n', sigma_c_bar);
        fprintf('Tensao Aplicada     : %8.2f MPa\n', sigma_apl);
        
    else
        sigma_c_aplicada = (N / A) + sigma_flexao; 
        
        eps_0 = 0.002; 
        C_mat = E / (5.88 * sqrt((sigma_y/E) + eps_0));
        
        F_cc_f = 20.7 * C_mat * (K^(2/3)) * (tb / t);
        
        R_cu = sigma_c_aplicada / F_cc_cr(i);
        R_cf = sigma_induzida / F_cc_f;
        
        MS = (1 / (R_cu + R_cf)) - 1;
        
        fprintf('Tensao Compressao   : %8.2f MPa\n', sigma_c_aplicada);
        fprintf('Tensao TSD Induzida : %8.2f MPa\n', sigma_induzida);
        fprintf('Tensao Crippling (F): %8.2f MPa\n', F_cc_f);
        fprintf('Razao R_cu          : %8.4f\n', R_cu);
        fprintf('Razao R_cf          : %8.4f\n', R_cf);
    end
    
    fprintf('MARGEM DE SEGURANCA : %8.2f\n', MS);
    if MS > 0
        fprintf('ESTADO: SEGURO\n\n');
    else
        fprintf('ESTADO: FALHA ESTRUTURAL\n\n');
    end
end
